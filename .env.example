APP_NAME=Daawa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Second domain for personal guest links, e.g. https://daawa.link (falls back to APP_URL)
INVITE_URL=

# Arabic first, English toggle
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=daawa
DB_USERNAME=daawa
DB_PASSWORD=

# Redis for cache, sessions, queues (Horizon) and rate limiting
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=daawa_cache_
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# uploads: public locally, s3 in production
MEDIA_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Hetzner Object Storage or Cloudflare R2 (S3 compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google sign-in (Socialite); callback: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Account area (config/account.php): "Email me a code" sign-in, and the days before a deletion request runs
LOGIN_CODES_ENABLED=true
ACCOUNT_DELETION_GRACE_DAYS=14

# Reverb (self-hosted WebSockets). Generate with: php artisan reverb:install
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Where the Reverb server itself listens (Forge daemon); Nginx proxies wss:// to it in production
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Cloudflare: purge an invitation's edge cache when the host edits it (App\Jobs\PurgeEdgeCache).
# Zone ID: the zone's Overview page. Token: My Profile → API Tokens, permission Zone → Cache Purge → Purge,
# limited to this zone. Empty: purges are skipped (logged) and the 5-minute edge TTL bounds staleness.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# seconds a purge waits so a burst of autosaves purges once
CLOUDFLARE_PURGE_DELAY=10

# Error reporting (Sentry). Server: config/sentry.php, phones and emails are scrubbed before sending.
SENTRY_LARAVEL_DSN=
# share of requests traced for performance (0 to 1); 0.1 is a good start, empty = no tracing
SENTRY_TRACES_SAMPLE_RATE=
# Browser (Inertia pages only, never guest invitations); read by `npm run build`. Empty = SDK not bundled.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Product analytics (PostHog, plan section 22). Browser: public site and Inertia pages, only after the
# visitor accepts the cookie banner; read by `npm run build`. Server: order_paid and design_yours_clicked
# from queued jobs. Empty keys = nothing is sent. The EU host keeps data in the EU.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Laravel Pulse (/pulse, admins only). Entries go to Redis and `php artisan pulse:work` (a daemon)
# stores them in the database; `php artisan pulse:check` (a daemon) records server CPU, memory and disk.
PULSE_ENABLED=true
PULSE_INGEST_DRIVER=redis
PULSE_STORAGE_KEEP="7 days"

# Security headers (config/security.php). The CSP starts report-only; set true once reports are clean.
CSP_ENFORCE=false
# extra origins for uploaded media or fetch(), comma separated (the media disk's URL is added automatically)
CSP_MEDIA_HOSTS=
CSP_CONNECT_HOSTS=

# Public site (config/marketing.php): showcase invitation tokens on the landing page in production
# (comma separated; outside production the demo invitations are shown), contact email, social profile URLs
MARKETING_SHOWCASE_TOKENS=
MARKETING_CONTACT_EMAIL=
MARKETING_SOCIAL_URLS=

# Link preview images (/i/{token}/og.png): headless Chromium screenshots a small Blade view.
# Empty path: look in /usr/bin (chromium, google-chrome). See config/og.php and docs/DEPLOY.md.
OG_CHROME_PATH=
OG_CHROME_NO_SANDBOX=false

# Payments (config/payments.php, docs/DEPLOY.md section 10). Bank transfer approved by an admin is the main
# method in Syria and Saudi Arabia; each card gateway stays off until all of its keys are set.
# WhatsApp number that receives transfer receipts, international digits without + (e.g. 963912345678)
PAYMENTS_WHATSAPP_NUMBER=
# One bank account per currency. A currency needs an IBAN or an account number to be offered for transfers.
PAYMENTS_BANK_SYP_ACCOUNT_NAME=
PAYMENTS_BANK_SYP_BANK=
PAYMENTS_BANK_SYP_IBAN=
PAYMENTS_BANK_SYP_ACCOUNT_NUMBER=
PAYMENTS_BANK_SYP_SWIFT=
# shown under the details, e.g. the local transfer company accepted inside Syria
PAYMENTS_BANK_SYP_NOTE=
PAYMENTS_BANK_SAR_ACCOUNT_NAME=
PAYMENTS_BANK_SAR_BANK=
PAYMENTS_BANK_SAR_IBAN=
PAYMENTS_BANK_SAR_ACCOUNT_NUMBER=
PAYMENTS_BANK_SAR_SWIFT=
PAYMENTS_BANK_SAR_NOTE=
PAYMENTS_BANK_USD_ACCOUNT_NAME=
PAYMENTS_BANK_USD_BANK=
PAYMENTS_BANK_USD_IBAN=
PAYMENTS_BANK_USD_ACCOUNT_NUMBER=
PAYMENTS_BANK_USD_SWIFT=
PAYMENTS_BANK_USD_NOTE=
# hours a transfer order waits for its receipt before expiring
PAYMENTS_TRANSFER_EXPIRES_HOURS=48
# switch a configured method off without removing its keys
PAYMENTS_TRANSFER_ENABLED=true
PAYMENTS_STRIPE_ENABLED=true
PAYMENTS_LEMON_SQUEEZY_ENABLED=true

# Stripe through Laravel Cashier: SAR and USD (SYP orders are charged the USD price).
# Webhook endpoint: ${APP_URL}/webhooks/stripe (checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Lemon Squeezy: charges the store currency (USD) with a custom price on one single-payment variant.
# Webhook endpoint: ${APP_URL}/webhooks/lemon-squeezy (order_created, order_refunded)
LEMON_SQUEEZY_API_KEY=
# the store id (the number after # in Settings → Stores)
LEMON_SQUEEZY_STORE=
LEMON_SQUEEZY_SIGNING_SECRET=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_CURRENCY=USD

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Invoices and VAT (config/invoicing.php, docs/INVOICES.md). Empty VAT number: receipts without VAT.
INVOICE_SELLER_NAME_AR=دعوة
INVOICE_SELLER_NAME_EN=Daawa
INVOICE_SELLER_ADDRESS_AR=
INVOICE_SELLER_ADDRESS_EN=
INVOICE_CR_NUMBER=
INVOICE_VAT_NUMBER=
INVOICE_VAT_RATE=15
INVOICE_PRICES_INCLUDE_VAT=true
INVOICE_VAT_CURRENCIES=SAR
INVOICE_VAT_COUNTRIES=
INVOICE_PREFIX=INV
INVOICE_CREDIT_NOTE_PREFIX=CN
INVOICE_TIMEZONE=Asia/Riyadh

# Storage period expiry (config/retention.php)
STORAGE_ARCHIVE_GRACE_DAYS=30
STORAGE_EXTEND_ADDON=photo_cloud_90d

# Phase 7B, guest extras (docs/GUEST_EXTRAS.md)
# Album limits (MB) and video caps; see config/album.php for the rest
ALBUM_MAX_MB=5120
ALBUM_MAX_MB_SIGNATURE=10240
ALBUM_VIDEO_MAX_SECONDS=60
ALBUM_VIDEO_MAX_MB=100
# Apple Wallet: Pass Type ID certificate (.p12 or PEM with key), its password, Apple WWDR intermediate (PEM)
APPLE_PASS_CERT_PATH=
APPLE_PASS_CERT_PASSWORD=
APPLE_PASS_WWDR_PATH=
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
# Google Wallet: issuer id and the service account's JSON key file
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# AI writing with Claude (story, poem, guest-list cleanup). AI_FAKE=true answers with canned text (local only).
ANTHROPIC_API_KEY=
AI_FAKE=false
AI_MODEL_STORY=claude-sonnet-5-5
AI_MODEL_POEM=claude-sonnet-5-5
AI_MODEL_CLEAN=claude-haiku-5-5

# Phase 8D: after the event and the family journey (docs/AFTER_EVENT.md)
FFMPEG_PATH=/usr/bin/ffmpeg
HIGHLIGHT_TIMEOUT=900
HIGHLIGHT_MAX_MB=200
PHOTO_BOOK_BLEED_MM=3
PHOTO_BOOK_SLUG_MM=6
JOURNEY_LOYALTY_PERCENT=10
JOURNEY_REFERRAL_MONTHLY_CAP=10
